# Variables de entorno — copiar a .env.local y completar.
# NUNCA subir .env.local ni claves reales al repositorio.

# Clave de la API de Anthropic para el asistente de chat (servidor).
# Obtenerla en https://console.anthropic.com/ y cargarla también en
# Vercel → Settings → Environment Variables (Production y Preview).
ANTHROPIC_API_KEY=

# URL pública del sitio (opcional; por defecto http://localhost:3000 en dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000

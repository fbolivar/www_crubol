# Variables de entorno — copiar a .env.local y completar.
# NUNCA subir .env.local ni claves reales al repositorio.

# Clave de la API de Anthropic para el asistente de chat (servidor).
# Obtenerla en https://console.anthropic.com/ y cargarla también en
# Vercel → Settings → Environment Variables (Production y Preview).
ANTHROPIC_API_KEY=

# URL pública del sitio (opcional; por defecto http://localhost:3000 en dev).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Envío del formulario de contacto por SMTP (Titan Email).
# La contraseña va SOLO en .env.local y en Vercel; nunca en el repositorio.
SMTP_HOST=smtp.titan.email
SMTP_PORT=465
SMTP_USER=info@crubol.com
SMTP_PASSWORD=
SMTP_FROM="Crubol Web <info@crubol.com>"
# Destino de los mensajes del formulario (por defecto, SMTP_USER).
SMTP_TO=info@crubol.com
